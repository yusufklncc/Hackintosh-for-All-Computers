<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Shell.Views"
             x:Class="Shell.Views.BuilderView"
             x:DataType="v:BuilderView">
  <!-- The question first, the transcript under it and folded away: what a
       person has to decide is the top of the pane, and what the engine said
       on the way is there for whoever wants it. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28,24,28,24">

    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,14">
      <TextBlock Classes="eyebrow" Text="BUILD AN EFI" />
      <TextBlock Name="Blurb" FontSize="13.5" TextWrapping="Wrap" MaxWidth="680"
                 HorizontalAlignment="Left" Foreground="{DynamicResource Muted}"
                 Text="The questions the console asks, one at a time. Where this machine can tell, the answer is ready and marked detected, and you still choose. Click an answer above a question to go back to it." />
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Classes="eyebrow" Text="WRITE TO"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Name="OutFolder" Classes="mono"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Name="Choose" Content="Change…" />
      </Grid>
      <!-- each answer given so far, numbered; each one a way back to its
           question, so a wrong answer is one click from being changed -->
      <WrapPanel Name="Trail" Orientation="Horizontal" IsVisible="False" />
    </StackPanel>

    <!-- the hardware in a line, and the two switches: the expert questions,
         and the engine's own words -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Margin="0,0,0,4">
      <WrapPanel Grid.Column="0" Name="HwSummary" Orientation="Horizontal"
                 VerticalAlignment="Center" />
      <CheckBox Grid.Column="1" Name="AskAll" VerticalAlignment="Center"
                Content="Advanced: ask the expert questions too"
                ToolTip.Tip="The framebuffer id and a faked device-id. Off, the detected answer is taken and shown above, where it can be changed." />
      <ToggleButton Grid.Column="2" Name="DetailsToggle" Content="Show details"
                    VerticalAlignment="Center" />
    </Grid>

    <!-- The question, the wait, or the end, in the room the details leave:
         a finished build's cards and drivers were taller than that room, and
         with the details open the transcript was squeezed to a sliver. This
         part scrolls; the details keep a share of the pane of their own. -->
    <ScrollViewer Grid.Row="2" Name="Main" VerticalScrollBarVisibility="Auto">
    <Panel>
    <!-- The question that is open, if one is -->
    <Border Name="Prompt" Classes="panel" Margin="0,16,0,0" IsVisible="False">
      <StackPanel Spacing="12">
        <StackPanel Spacing="3">
          <TextBlock Name="Step" Classes="eyebrow" IsVisible="False" />
          <TextBlock Name="QuestionText" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
          <TextBlock Name="Hint" FontSize="12.5" Foreground="{DynamicResource Muted}"
                     TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
        <!-- A question can have thirty answers - an Ice Lake framebuffer has.
             Unbounded, the list took the whole window, pushed Continue off the
             bottom and left the transcript no height at all (issue #104). It
             scrolls inside a share of the window instead; the share is set
             from the pane's height in code. -->
        <ScrollViewer Name="OptionsScroll" MaxHeight="320"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Name="Options" Spacing="2" Margin="0,0,12,0" />
        </ScrollViewer>
        <TextBox Name="FreeText" Watermark="a path, or leave empty to decline"
                 IsVisible="False" FontFamily="{DynamicResource Mono}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="Back" Content="← Back" IsEnabled="False" />
          <Button Name="Stop" Content="Stop" />
          <Button Name="Continue" Content="Continue" IsDefault="True"
                  Classes="accent" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- While the engine works and nothing is being asked -->
    <v:Busy Name="Waiting" IsVisible="False" Margin="2,18,0,0" />

    <!-- Before it starts, and after it ends -->
    <Border Name="Standby" Classes="panel" Margin="0,16,0,0">
      <!-- the sentence and the buttons on one row, and what was written
           under both at the full width: beside the buttons the cards were
           squeezed into a column and took the transcript's height -->
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="3" VerticalAlignment="Center">
          <TextBlock Name="StandbyTitle" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink}" Text="Ready" />
          <TextBlock Name="StandbyText" FontSize="12.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource Muted}"
                     Text="This builds for the machine it runs on." />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
          <!-- what was written, read back from the folder: the few facts a
               person needs next, rather than a path and a transcript -->
          <WrapPanel Name="Facts" Orientation="Horizontal" Margin="0,12,0,0" IsVisible="False" />
          <StackPanel Name="LeftToDo" Spacing="4" Margin="0,6,0,0" IsVisible="False">
            <TextBlock Classes="eyebrow" Text="LEFT TO DO BY HAND" />
            <StackPanel Name="LeftRows" Spacing="2" />
          </StackPanel>
          <!-- community drivers the build added, each one a button away from
               gone: the EFI keeps how it was before any of them -->
          <StackPanel Name="Added" Spacing="6" Margin="0,10,0,0" IsVisible="False">
            <TextBlock Classes="eyebrow" Text="COMMUNITY DRIVERS IN THIS EFI" />
            <StackPanel Name="AddedRows" Spacing="4" />
            <TextBlock Name="AddedNote" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Faint}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <Button Name="Open" Content="Show the EFI folder" IsVisible="False" />
          <Button Name="Begin" Content="Start" Classes="accent" />
          <!-- once there is an EFI, the next thing is a stick to put it on -->
          <Button Name="ToStick" Content="Put it on a stick  →" Classes="accent" IsVisible="False" />
        </StackPanel>
      </Grid>
    </Border>

    </Panel>
    </ScrollViewer>

    <!-- What the engine has said so far, in the colours it said it in -->
    <Border Grid.Row="3" Name="Details" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="8" Background="{DynamicResource Surface2}" ClipToBounds="True"
            Margin="0,16,0,0" IsVisible="False">
      <!-- The console lines up its columns with spaces, so wrapping them would
           take the alignment apart. It scrolls sideways instead. -->
      <!-- Room under the last line, in the content and not on the viewer.
           A ScrollViewer's Padding shrinks what is on screen without adding
           anything to scroll through, so the last rows sat behind it: the
           scroller reported itself at the end, the check agreed, and a menu
           still ended two lines early. A margin on the panel is part of the
           extent, so the end can actually be reached. -->
      <ScrollViewer Name="Scroll" Padding="16,12,16,0"
                    HorizontalScrollBarVisibility="Auto">
        <StackPanel Name="Transcript" Spacing="1" Margin="0,0,0,28" />
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
