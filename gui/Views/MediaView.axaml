<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Shell.Views"
             xmlns:e="clr-namespace:Shell.Engine"
             x:Class="Shell.Views.MediaView"
             x:DataType="v:MediaView">
  <!-- One pane for one job: macOS and the EFI on a stick. It used to be three
       - Recovery downloaded into a folder, USB stick copied that folder over,
       and Installer made an image - and the way to choose between them was to
       know already which one fitted. Here the choice comes first, with the one
       this machine's network makes sensible marked, and the rest follows it. -->
  <Grid RowDefinitions="*,Auto">
  <ScrollViewer Grid.Row="0">
    <StackPanel Margin="28,24" Spacing="18" MaxWidth="890" HorizontalAlignment="Left">
      <StackPanel Spacing="8">
        <TextBlock Classes="eyebrow" Text="THE USB STICK" />
        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"
                   Text="Put macOS and the EFI on a stick." />
      </StackPanel>

      <v:Busy Name="Loading" Text="Reading the macOS list, this machine's network and the sticks…" />

      <!-- hidden until the first read is in, then faded in: tiles that fill
           in one by one under a reader's eyes read as a broken page -->
      <StackPanel Name="Body" Spacing="18" Opacity="0" IsVisible="False">
        <StackPanel.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
          </Transitions>
        </StackPanel.Transitions>
      <!-- three steps, one on screen at a time; each a way back to it -->
      <StackPanel Name="Steps" Orientation="Horizontal" Spacing="8" />

      <StackPanel Name="StepWay" Spacing="14">
      <TextBlock Classes="eyebrow" Text="1 · HOW MACOS GETS ONTO IT" />
      <ListBox Name="Ways" Classes="tiles" SelectionMode="Single"
               Background="Transparent" BorderThickness="0" Padding="0"
               x:DataType="v:Way">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="v:Way">
            <StackPanel Width="262" Height="104" Margin="0,2" Spacing="5"
                        Opacity="{Binding Dim}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" />
                <Border Classes="pill ok" IsVisible="{Binding Recommended}"
                        VerticalAlignment="Center">
                  <TextBlock Text="for this machine" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Cost}" FontSize="12.5" TextWrapping="Wrap"
                         Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Name="WayNote" FontSize="12.5" TextWrapping="Wrap"
                 Foreground="{DynamicResource Muted}" />

      </StackPanel>

      <StackPanel Name="StepMacos" Spacing="14" IsVisible="False">
      <TextBlock Name="Step2" Classes="eyebrow" Text="2 · WHICH MACOS" />
      <v:RecoveryView Name="Recovery" />
      <StackPanel Name="Offline" Spacing="10" IsVisible="False">
        <ComboBox Name="Build" HorizontalAlignment="Stretch"
                  PlaceholderText="Reading Apple's catalog…" x:DataType="e:OfflineChoice">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="e:OfflineChoice">
              <Grid ColumnDefinitions="250,*" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="{Binding Titled}" />
                <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="mono"
                           Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <v:Busy Name="Cataloguing" IsVisible="False" />
        <TextBlock Name="BuildNote" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource Muted}" />
      </StackPanel>
      <v:InstallerView Name="Image" IsVisible="False" />
      </StackPanel>

      <StackPanel Name="StepStick" Spacing="14" IsVisible="False">
      <TextBlock Name="Step3" Classes="eyebrow" Text="3 · WHICH STICK" />
      <v:StickView Name="Stick" />
      </StackPanel>

      </StackPanel>
    </StackPanel>
  </ScrollViewer>

  <!-- Back, what the last step will do, and Next - or, on the last step, the
       button every step leads to - held at the bottom of the pane -->
  <Border Grid.Row="1" Name="GoRow" IsVisible="False" Background="{DynamicResource Surface}"
          BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,12">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" MaxWidth="890">
      <Button Grid.Column="0" Name="StepBack" Content="← Back" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Name="GoNote" FontSize="12.5" TextWrapping="Wrap"
                 VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
      <Button Grid.Column="2" Name="Next" Content="Next  →" Classes="accent"
              VerticalAlignment="Center" />
      <Button Grid.Column="3" Name="Go" Content="Put it on the stick" Classes="accent"
              IsEnabled="False" VerticalAlignment="Center" />
    </Grid>
  </Border>
  </Grid>
</UserControl>
