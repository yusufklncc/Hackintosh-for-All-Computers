<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Shell.Views"
        x:Class="Shell.Views.MainWindow"
        x:DataType="v:MainWindow"
        Title="Hackintosh EFI Builder"
        Icon="avares://HackintoshEFIBuilder/Assets/Icon/png/icon-256.png"
        Width="1180" Height="780" MinWidth="880" MinHeight="600"
        Background="{DynamicResource Ground}"
        Foreground="{DynamicResource Ink}">
  <Grid ColumnDefinitions="216,*">

    <!-- Sidebar. The panes are named for what a person came to do, not for
         which part of the program answers them. -->
    <Border Grid.Column="0" Background="{DynamicResource Surface2}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10"
                    Margin="10,6,10,18">
          <!-- The application's own icon, not a second drawing of it. The
               glyph that stood here was the same chip redrawn by hand, and
               two drawings of one mark drift apart the moment either is
               touched. Scaled down from 256, so it stays sharp on a display
               that renders this at twice the size. -->
          <Image Width="26" Height="26"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 Source="avares://HackintoshEFIBuilder/Assets/Icon/png/icon-256.png" />
          <StackPanel>
            <TextBlock Text="EFI Builder" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink}" />
            <TextBlock Name="Version" FontSize="11"
                       FontFamily="{DynamicResource Mono}"
                       Foreground="{DynamicResource Faint}" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="10,12,10,2">
          <!-- only when a newer build of the release is out; it opens the
               About pane, where installing it is one button -->
          <Button Name="UpdateNote" IsVisible="False" Classes="accent"
                  HorizontalAlignment="Stretch" Margin="0,0,0,10"
                  Content="Update available" />
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,10" />
          <TextBlock Name="StandingFacts" FontSize="11" LineHeight="17"
                     FontFamily="{DynamicResource Mono}"
                     Foreground="{DynamicResource Faint}" />
        </StackPanel>

        <!-- In the order the work goes: the machine, the EFI for it, the stick
             it boots from. Report, Recovery and Installer were panes of their
             own once; a report is now part of the machine, and the three ways
             of putting macOS on a stick are one pane that asks which. -->
        <StackPanel Spacing="2">
          <TextBlock Classes="eyebrow" Text="THIS MACHINE" Margin="12,0,0,4" />
          <!-- the three steps of the work, each ticked once it has been done
               in this session: read, built, written to a stick -->
          <RadioButton Name="ToMachine" Classes="nav" GroupName="pane" IsChecked="True">
            <DockPanel>
              <TextBlock Name="MachineDone" DockPanel.Dock="Right" Text="✓" IsVisible="False"
                         Foreground="{DynamicResource Ok}" FontWeight="Bold" />
              <TextBlock Text="Machine" />
            </DockPanel>
          </RadioButton>
          <TextBlock Classes="eyebrow" Text="MAKE" Margin="12,14,0,4" />
          <RadioButton Name="ToBuilder" Classes="nav" GroupName="pane">
            <DockPanel>
              <TextBlock Name="EfiDone" DockPanel.Dock="Right" Text="✓" IsVisible="False"
                         Foreground="{DynamicResource Ok}" FontWeight="Bold" />
              <TextBlock Text="EFI" />
            </DockPanel>
          </RadioButton>
          <RadioButton Name="ToStick" Classes="nav" GroupName="pane">
            <DockPanel>
              <TextBlock Name="StickDone" DockPanel.Dock="Right" Text="✓" IsVisible="False"
                         Foreground="{DynamicResource Ok}" FontWeight="Bold" />
              <TextBlock Text="USB stick" />
            </DockPanel>
          </RadioButton>
          <Border Height="1" Background="{DynamicResource Line}" Margin="10,14,10,10" />
          <RadioButton Name="ToDevices" Classes="nav" GroupName="pane"
                       Content="Compatible Hardware" />
          <RadioButton Name="ToKexts" Classes="nav" GroupName="pane" Content="Kexts" />
          <RadioButton Name="ToAbout" Classes="nav" GroupName="pane" Content="About" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Panel Grid.Column="1" Background="{DynamicResource Surface}">
      <!-- Both panes live for the whole session. The builder holds a running
           engine and a transcript; rebuilding it on every click would throw
           both away. -->
      <ScrollViewer Name="MachinePane">
        <StackPanel>
          <v:MachineView Name="MachineInfo" />
          <v:ReportView Name="ReportPart" />
        </StackPanel>
      </ScrollViewer>
      <v:BuilderView Name="BuilderPane" IsVisible="False" />
      <v:MediaView Name="StickPane" IsVisible="False" />
      <v:DevicesView Name="DevicesPane" IsVisible="False" />
      <v:KextsView Name="KextsPane" IsVisible="False" />
      <v:AboutView Name="AboutPane" IsVisible="False" />
    </Panel>
  </Grid>
</Window>
