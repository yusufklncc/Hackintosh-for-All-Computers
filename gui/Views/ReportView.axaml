<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Shell.Views"
             x:Class="Shell.Views.ReportView"
             x:DataType="v:ReportView">
  <!-- Part of the Machine pane, under the table: a report is this machine
       written down, and opening one is that pane showing another machine. -->
  <StackPanel Margin="28,8,28,28" Spacing="16" MaxWidth="740" HorizontalAlignment="Left">
    <StackPanel Spacing="8">
      <TextBlock Classes="eyebrow" Text="ANOTHER MACHINE" />
      <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                 Text="A USB stick is usually made on a computer that already works, not on the one being converted. Save a report on the one being converted, carry the file back, and open it here: this pane, the EFI builder's answers and the USB stick's advice are then about that machine." />
    </StackPanel>

    <Border Classes="panel">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Name="Showing" FontSize="13" TextWrapping="Wrap"
                   VerticalAlignment="Center" Foreground="{DynamicResource Ink}"
                   Text="Showing this machine." />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Name="OpenReport" Content="Open a report…" />
          <Button Name="Back" Content="Back to this machine" IsVisible="False" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="panel">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Classes="eyebrow" Text="WRITE TO"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="Where" Classes="mono"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Name="Choose" Content="Change…" />
        </Grid>
        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Faint}"
                   Text="The machine's ACPI tables are dumped beside it where that is possible, because the SSDTs have to be written against the tables of the machine they are for." />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
          <Button Name="Take" Content="Save this machine's report" Classes="accent" />
          <Button Name="Open" Content="Show the file" IsVisible="False" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Name="Result" Classes="panel" IsVisible="False">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <v:Busy Name="Working" IsVisible="False" VerticalAlignment="Center" />
          <TextBlock Name="ResultTitle" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink}" />
        </StackPanel>
        <TextBlock Name="ResultText" Classes="mono" TextWrapping="Wrap" />
        <TextBlock Name="ResultNext" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource Muted}" IsVisible="False" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
