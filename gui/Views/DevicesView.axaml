<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Shell.Views"
             x:Class="Shell.Views.DevicesView"
             x:DataType="v:DevicesView">
  <UserControl.Styles>
    <!-- two tabs drawn as words with a line under the one that is open, not
         as radio circles: they say which list is showing, they pick nothing -->
    <Style Selector="RadioButton.tab">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Under" Padding="2,6,2,7" BorderThickness="0,0,0,2"
                  BorderBrush="Transparent" Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.tab:checked">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ Border#Under">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="RadioButton.tab:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="28,24">
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
      <TextBlock Classes="eyebrow" Text="EVERY DEVICE THIS PROGRAM KNOWS" />
      <v:Busy Name="Reading" IsVisible="False" />
      <TextBlock Name="Blurb" FontSize="13.5" TextWrapping="Wrap" MaxWidth="760"
                 HorizontalAlignment="Left" Foreground="{DynamicResource Muted}" />
    </StackPanel>

    <!-- What this EFI drives, and what somebody else's driver does. They are
         different promises, and one list with a status column made them read
         as the same kind of answer. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="22" Margin="0,0,0,14">
      <RadioButton Name="ToShipped" Classes="tab" GroupName="devices" IsChecked="True"
                   Content="In this EFI" />
      <RadioButton Name="ToCommunity" Classes="tab" GroupName="devices" />
    </StackPanel>

    <Grid Grid.Row="2" Name="Filters" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10"
          Margin="0,0,0,14">
      <TextBox Grid.Column="0" Name="Search" Watermark="Search a name, an id or a kext"
               MaxWidth="360" HorizontalAlignment="Left" Padding="10,6,14,6" />
      <ComboBox Grid.Column="1" Name="Category" MinWidth="140" />
      <ComboBox Grid.Column="2" Name="Status" MinWidth="130" />
      <ComboBox Grid.Column="3" Name="Vendor" MinWidth="170" />
    </Grid>

    <Border Grid.Row="3" Name="Table" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="8" ClipToBounds="True">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="14,10">
          <Grid ColumnDefinitions="112,*,124,110,132,150">
            <!-- The two columns worth ordering by. The rest are a vendor name
                 repeated hundreds of times, a hex id, and a kext name. -->
            <Button Grid.Column="0" Name="SortCategory" Classes="sorter">
              <TextBlock Name="SortCategoryLabel" Classes="eyebrow" Text="CATEGORY" />
            </Button>
            <Button Grid.Column="1" Name="SortName" Classes="sorter">
              <TextBlock Name="SortNameLabel" Classes="eyebrow" Text="DEVICE" />
            </Button>
            <TextBlock Grid.Column="2" Classes="eyebrow" Text="SUPPORT" />
            <TextBlock Grid.Column="3" Classes="eyebrow" Text="MACOS" />
            <TextBlock Grid.Column="4" Classes="eyebrow" Text="VENDOR" />
            <TextBlock Grid.Column="5" Classes="eyebrow" Text="ID / DRIVER" />
          </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Name="Count" Classes="mono"
                   Margin="14,8" />
        <!-- A ListBox, not an ItemsControl in a ScrollViewer: that builds a
             control for all seven hundred rows on every keystroke. This one
             builds the dozen on screen. -->
        <ListBox Name="Rows" Classes="rows" Background="Transparent" BorderThickness="0"
                 SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="v:DeviceItem">
              <Grid ColumnDefinitions="112,*,124,110,132,150">
                <TextBlock Grid.Column="0" Text="{Binding Category}" FontSize="12.5"
                           Foreground="{DynamicResource Muted}" />
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Name}" FontSize="13.5"
                             Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Note}" FontSize="12"
                             IsVisible="{Binding HasNote}"
                             Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" Classes="pill" VerticalAlignment="Top"
                        Margin="0,0,12,0"
                        Classes.ok="{Binding IsOk}" Classes.bad="{Binding IsBad}"
                        Classes.warn="{Binding IsUnclear}">
                  <TextBlock Text="{Binding Status}" />
                </Border>
                <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Macos}"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
                <TextBlock Grid.Column="4" Text="{Binding Vendor}" FontSize="12.5"
                           Margin="0,0,12,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Muted}" />
                <StackPanel Grid.Column="5">
                  <TextBlock Classes="mono" Text="{Binding Id}" TextWrapping="Wrap" />
                  <TextBlock Classes="mono kext" Text="{Binding Kext}"
                             IsVisible="{Binding HasKext}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- The community registry, one card per project, in its own words -->
    <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Name="Community" IsVisible="False">
      <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,0,24">
        <TextBlock Name="CommunityBlurb" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource Muted}" />
        <!-- the same kind of filters the other tab has, for the questions a
             person brings to this list: my card, this category, how it goes in,
             and how it was written -->
        <WrapPanel Orientation="Horizontal">
          <TextBox Name="CommunitySearch" Watermark="Search a name, a card or an id"
                   Width="260" Padding="10,6,14,6" Margin="0,0,10,8" />
          <ComboBox Name="CommunityRole" MinWidth="130" Margin="0,0,10,8" />
          <ComboBox Name="CommunityInstall" MinWidth="200" Margin="0,0,10,8" />
          <ComboBox Name="CommunityAi" MinWidth="150" Margin="0,0,10,8" />
          <CheckBox Name="OnlyMine" Content="Only what fits this machine"
                    Margin="0,0,10,8" VerticalAlignment="Center" />
        </WrapPanel>
        <TextBlock Name="CommunityCount" Classes="mono" FontSize="12"
                   Foreground="{DynamicResource Faint}" />
        <TextBlock Classes="eyebrow" Text="EXPERIMENTAL, BY THEIR OWN ACCOUNT" />
        <ItemsControl Name="Shown">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="v:CommunityItem">
              <Border Classes="panel" Padding="16,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <WrapPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Ink}" Margin="0,0,10,4"
                                 VerticalAlignment="Center" />
                      <Border Classes="pill" Margin="0,0,6,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Role}" />
                      </Border>
                      <Border Classes="pill warn" Margin="0,0,6,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Stage}" />
                      </Border>
                      <Border Classes="pill" Margin="0,0,6,4" VerticalAlignment="Center"
                              IsVisible="{Binding HasAi}">
                        <TextBlock Text="{Binding AiBadge}" />
                      </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Covers}" FontSize="13.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="{Binding Said}" FontSize="12.5" FontStyle="Italic"
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                               IsVisible="{Binding HasSaid}" />
                    <TextBlock Text="{Binding Facts}" Classes="mono" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource Faint}" />
                    <TextBlock Text="{Binding Macos}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" />
                    <TextBlock Text="{Binding Where}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" />
                    <TextBlock Text="{Binding Needs}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" IsVisible="{Binding HasNeeds}" />
                    <TextBlock Text="{Binding AiWhy}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Faint}" IsVisible="{Binding HasAi}" />
                    <TextBlock Text="{Binding Uploaded}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Faint}" IsVisible="{Binding HasUploaded}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                    <Button Content="Open on GitHub" HorizontalAlignment="Stretch"
                            Tag="{Binding Url}" Click="OpenProject" />
                    <!-- an issue form with this machine filled in: what moves a
                         driver from experimental to recommended is people
                         saying it ran -->
                    <Button Content="Report how it ran" HorizontalAlignment="Stretch"
                            Tag="{Binding Report}" Click="OpenProject"
                            IsVisible="{Binding HasReport}"
                            ToolTip.Tip="Opens a GitHub issue with this machine's processor and matching device ids filled in. You read it before sending." />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="eyebrow" Text="WATCHED, NOT SHOWN YET" Margin="0,10,0,0" />
        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                   Text="Recorded, and kept up to date, but not offered: no release to read, no licence, or archived. A person moves one up when that changes." />
        <ItemsControl Name="Watched">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="v:CommunityItem">
              <Grid ColumnDefinitions="200,110,*,Auto" ColumnSpacing="10" Margin="0,6">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                           Foreground="{DynamicResource Ink}" />
                <TextBlock Grid.Column="1" Text="{Binding Role}" FontSize="12.5"
                           Foreground="{DynamicResource Muted}" />
                <TextBlock Grid.Column="2" Text="{Binding Covers}" FontSize="12.5"
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                <Button Grid.Column="3" Content="GitHub" Tag="{Binding Url}" Click="OpenProject" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
