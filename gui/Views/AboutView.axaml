<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Shell.Views"
             x:Class="Shell.Views.AboutView"
             x:DataType="v:AboutView">
  <ScrollViewer>
    <StackPanel Margin="28,24,28,32" Spacing="20">

      <StackPanel Spacing="8" MaxWidth="740" HorizontalAlignment="Left">
        <TextBlock Classes="eyebrow" Text="ABOUT" />
        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"
                   Text="An OpenCore EFI builder that answers from tables, and says where each table came from." />
        <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                   Text="Nothing here reaches the network. The machine an EFI is prepared on is usually the machine about to be replaced, and it is often not online - so every kext, every profile and both ACPI tools travel inside the program." />
      </StackPanel>

      <ItemsControl Name="Counts">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="v:CountItem">
            <Border Classes="panel" Margin="0,0,12,12" MinWidth="150">
              <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="{Binding Name}" />
                <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="WHERE THE ANSWERS COME FROM" />
        <TextBlock Name="Tally" FontSize="13" TextWrapping="Wrap" MaxWidth="740"
                   HorizontalAlignment="Left" Foreground="{DynamicResource Muted}" />
        <ItemsControl Name="Sources">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="v:SourceItem">
              <Border Classes="panel" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Area}" FontSize="14"
                               FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                    <Border Grid.Column="1" Classes="pill"
                            Classes.ok="{Binding IsDerived}"
                            Classes.warn="{Binding IsWeak}"
                            Classes.bad="{Binding IsNone}">
                      <TextBlock Text="{Binding Kind}" />
                    </Border>
                  </Grid>
                  <TextBlock Classes="mono" Text="{Binding Source}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Covers}" FontSize="12.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource Muted}" />
                  <TextBlock Text="{Binding Gap}" FontSize="12.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource Warn}" IsVisible="{Binding HasGap}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
